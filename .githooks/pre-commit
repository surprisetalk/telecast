#!/usr/bin/env bash
set -e

# NixOS keeps libstdc++ off the loader path, and sharp's addon links it. telecast-web on pc sets the same variable.
if [ -e /etc/NIXOS ]; then export LD_LIBRARY_PATH="$(dirname "$(gcc -print-file-name=libstdc++.so.6)")"; fi

# --no-install: a missing dev dependency fails here. Plain npx runs the newest release from the registry instead.
npx --no-install elm-format --validate src/ tests/
deno fmt --check server.ts server.test.ts functions/ scripts/
npx --no-install elm make src/Main.elm --output=/dev/null
# elm-test exits 0 when it crashes before running a test (e.g. listen EPERM on its socket), so check its summary line.
summary=$(npx --no-install elm-test --report=json | tail -n 1)
echo "$summary" | jq -e '.event == "runComplete" and .failed == "0" and (.passed | tonumber) > 0 and .autoFail == null' >/dev/null || {
  echo "elm-test: expected a runComplete line with failed 0, passed > 0, autoFail null. Received: ${summary:-<no output>}. Run npx elm-test to see why." >&2
  exit 1
}
deno check server.ts server.test.ts functions/ scripts/
deno test -A server.test.ts functions/ scripts/
(cd tui && test -z "$(gofmt -l .)" && go vet ./... && go test ./...)
